<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the Mac's bench hooks (BenchReceiver). DUMP is held by the adb shell and root, never by an app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.carlink.bench.BenchReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.enigy.carlink3.BENCH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
