# EditorConfig - https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
# Project line-length limit. Raised from ktlint's default (typically 120) to 180
# to match detekt.yml MaxLineLength — protocol documentation comments,
# audio/mic format notes, and log lines with interpolated variables legitimately
# exceed 140 and should not be wrapped at the cost of legibility.
max_line_length = 180

# ktlint configuration
ktlint_standard_no-unused-imports = enabled
# Composable functions use PascalCase per Jetpack Compose API Guidelines
# https://github.com/androidx/androidx/blob/androidx-main/compose/docs/compose-api-guidelines.md
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{java}]
indent_size = 4

[*.{xml,json}]
indent_size = 4

[*.{gradle,gradle.kts}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Carlink: verbatim ports from Carlink2 (kept byte-identical to stay diffable against it; Carlink2's
# ktlint ran with ignoreFailures=true, so these files were never shaped by it). Excluded here rather
# than reformatted. Files written for Carlink in these packages are NOT listed and stay gated.
[**/navigation/compose/*.kt]
ktlint = disabled

[**/navigation/NavigationStateManager.kt]
ktlint = disabled

[**/navigation/ManeuverMapper.kt]
ktlint = disabled

[**/cluster/ClusterMainSession.kt]
ktlint = disabled

[**/cluster/ClusterBindingState.kt]
ktlint = disabled

[**/navigation/DistanceFormatter.kt]
ktlint = disabled

[**/navigation/Iap2ManeuverData.kt]
ktlint = disabled

[**/navigation/Iap2RouteParser.kt]
ktlint = disabled

[**/navigation/Iap2StateParser.kt]
ktlint = disabled

[**/navigation/ManeuverIconRenderer.kt]
ktlint = disabled

[**/navigation/TripBuilder.kt]
ktlint = disabled

[**/cluster/CarlinkClusterService.kt]
ktlint = disabled

[**/cluster/CarlinkClusterSession.kt]
ktlint = disabled

# Connecting-screen and settings-glass components ported verbatim from Carlink2 (2026-10-19).
[**/ui/components/ForestFogEffect.kt]
ktlint = disabled

[**/ui/components/EtherealStatus.kt]
ktlint = disabled

[**/ui/components/LoadingSteps.kt]
ktlint = disabled

[**/ui/components/FrostedGlassBackground.kt]
ktlint = disabled

[**/ui/components/SettingsFlyIn.kt]
ktlint = disabled

[**/audio/AudioRouteInfo.kt]
ktlint = disabled

[**/util/FilesLauncher.kt]
ktlint = disabled
