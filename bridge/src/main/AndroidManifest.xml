<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- API 7, the bridge's own update (BridgeUpdater): fetch the APK Carlink pins from its GitHub release, and install
         it as an update of this package. Nothing else uses the network. UPDATE_PACKAGES_WITHOUT_USER_ACTION lets
         Android 12 and later skip the confirm when it allows; the bridge still handles one. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- CallerVerifier reads the display app's installer and signing certificate. -->
    <queries>
        <package android:name="com.enigy.carlink3" />
    </queries>

    <!-- No activity on purpose. The platform's fixed USB handler grants this package's UID
         permission for every attached device, THEN tries to start
         android.car.usb.handler.UsbHostManagementActivity. When that activity is missing the
         start fails with ActivityNotFoundException, which the platform catches and logs; the
         grant has already happened. Declaring the activity would put a sideloaded app on
         screen at every attach, which GM covers with the driving overlay (PR lvalen91/carlink#15). -->
    <application
        android:allowBackup="false"
        android:label="Carlink USB Bridge"
        tools:ignore="HardcodedText,MissingApplicationIcon">

        <!-- Bound only by com.enigy.carlink3; BridgeService rejects every other caller. -->
        <service
            android:name=".BridgeService"
            android:exported="true"
            tools:ignore="ExportedService" />

        <!-- The install session's status for the bridge's own update. Not exported: only the system's PendingIntent
             reaches it. -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="false" />

        <!-- The authority GoogleTemplatesHost writes cluster maneuver icons to but never
             registers. Must be exported: the host and the cluster read it from other UIDs. -->
        <provider
            android:name=".ClusterIconProvider"
            android:authorities="com.google.android.apps.automotive.templates.host.ClusterIconContentProvider"
            android:exported="true"
            android:grantUriPermissions="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
